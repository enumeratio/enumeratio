    "Scan": {
      "[\"Equal\",[\"Scan\",[\"List\",1,2,3,4],\"Add\"],[\"List\",1,3,6,10]]": {
        "wolfram": {
          "input": "(FoldList[Plus, List[1, 2, 3, 4]] == List[1, 3, 6, 10])",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Equal\",[\"Scan\",[\"List\",1,2,3,4],\"Max\"],[\"List\",1,2,3,4]]": {
        "wolfram": {
          "input": "(FoldList[Max, List[1, 2, 3, 4]] == List[1, 2, 3, 4])",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Equal\",[\"Scan\",[\"List\",1,2,3],\"Add\",10],[\"List\",11,13,16]]": {
        "wolfram": {
          "input": "(enumeratio`Scan[List[1, 2, 3], Plus, 10] == List[11, 13, 16])",
          "output": "enumeratio`Scan[{1, 2, 3}, Plus, 10] == {11, 13, 16}",
          "verdict": "disagree",
          "kind": "convention",
          "note": "Wolfram's seeded FoldList keeps the seed (length+1), so the seeded Scan has no Wolfram form."
