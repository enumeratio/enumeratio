    "Tabulate": {
      "[\"Equal\",[\"Tabulate\",[\"Function\",[\"Power\",\"_1\",2]],5],[\"List\",1,4,9,16,25]]": {
        "wolfram": {
          "input": "(Array[Function[Power[Slot[1], 2]], 5] == List[1, 4, 9, 16, 25])",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Equal\",[\"Tabulate\",[\"Function\",[\"Multiply\",\"_1\",\"_2\"]],2,2],[\"List\",[\"List\",1,2],[\"List\",2,4]]]": {
        "wolfram": {
          "input": "(Array[Function[Times[Slot[1], Slot[2]]], List[2, 2]] == List[List[1, 2], List[2, 4]])",
          "output": "True",
          "verdict": "agree"
        }
      }
    },
    "Fold": {
      "[\"Fold\",\"Add\",0,[\"List\",1,2,3,4]]": {
        "wolfram": {
          "input": "Fold[Plus, 0, List[1, 2, 3, 4]]",
