{
  "kernels": {
    "wolfram": "15.0.0 for Mac OS X ARM (64-bit) (May 26, 2026)",
    "sage": "SageMath version 10.9, Release Date: 2026-05-04"
  },
  "examples": {
    "All": {
      "all-list-2-4-6-function-1-mod-2-eq-0": {
        "wolfram": {
          "input": "AllTrue[List[2, 4, 6], Function[(Mod[Slot[1], 2] == 0)]]",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "\\text{AllTrue}[\\{2,4,6\\},(\\text{$\\#$1} \\bmod 2)=0\\&]",
            "output": "\\text{True}"
          }
        }
      },
      "all-list-2-4-5-function-1-mod-2-eq-0": {
        "wolfram": {
          "input": "AllTrue[List[2, 4, 5], Function[(Mod[Slot[1], 2] == 0)]]",
          "output": "False",
          "verdict": "agree",
          "tex": {
            "input": "\\text{AllTrue}[\\{2,4,5\\},(\\text{$\\#$1} \\bmod 2)=0\\&]",
            "output": "\\text{False}"
          }
        }
      }
    },
    "Any": {
      "any-list-1-3-5-function-1-mod-2-eq-0": {
        "wolfram": {
          "input": "AnyTrue[List[1, 3, 5], Function[(Mod[Slot[1], 2] == 0)]]",
          "output": "False",
          "verdict": "agree",
          "tex": {
            "input": "\\text{AnyTrue}[\\{1,3,5\\},(\\text{$\\#$1} \\bmod 2)=0\\&]",
            "output": "\\text{False}"
          }
        }
      },
      "any-list-1-3-6-function-1-mod-2-eq-0": {
        "wolfram": {
          "input": "AnyTrue[List[1, 3, 6], Function[(Mod[Slot[1], 2] == 0)]]",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "\\text{AnyTrue}[\\{1,3,6\\},(\\text{$\\#$1} \\bmod 2)=0\\&]",
            "output": "\\text{True}"
          }
        }
      }
    },
    "Tabulate": {
      "tabulate-function-1-pow-2-5": {
        "wolfram": {
          "input": "Array[Function[Power[Slot[1], 2]], 5]",
          "output": "{1, 4, 9, 16, 25}",
          "verdict": "agree",
          "tex": {
            "input": "\\text{Array}\\left[\\text{$\\#$1}^2\\&,5\\right]",
            "output": "\\{1,4,9,16,25\\}"
          }
        }
      },
      "the-multi-dimensional-form-a-rectangular-grid": {
        "wolfram": {
          "input": "Array[Function[Times[Slot[1], Slot[2]]], List[2, 2]]",
          "output": "{{1, 2}, {2, 4}}",
          "verdict": "agree",
          "tex": {
            "input": "\\text{Array}[\\text{$\\#$1} \\text{$\\#$2}\\&,\\{2,2\\}]",
            "output": "\\left( \\begin{array}{cc}  1 & 2 \\\\  2 & 4 \\\\ \\end{array} \\right)"
          }
        }
      }
    },
    "Fold": {
      "fold-add-0-list-1-2-3-4": {
        "wolfram": {
          "input": "Fold[Plus, 0, List[1, 2, 3, 4]]",
          "output": "10",
          "verdict": "agree",
          "tex": {
            "input": "\\text{Fold}[\\text{Plus},0,\\{1,2,3,4\\}]",
            "output": "10"
          }
        }
      },
      "fold-multiply-1-list-1-2-3-4": {
        "wolfram": {
          "input": "Fold[Times, 1, List[1, 2, 3, 4]]",
          "output": "24",
          "verdict": "agree",
          "tex": {
            "input": "\\text{Fold}[\\text{Times},1,\\{1,2,3,4\\}]",
            "output": "24"
          }
        }
      }
    },
    "Scan": {
      "scan-list-1-2-3-4-add": {
        "wolfram": {
          "input": "FoldList[Plus, List[1, 2, 3, 4]]",
          "output": "{1, 3, 6, 10}",
          "verdict": "agree",
          "tex": {
            "input": "\\text{FoldList}[\\text{Plus},\\{1,2,3,4\\}]",
            "output": "\\{1,3,6,10\\}"
          }
        }
      },
      "the-running-maximum": {
        "wolfram": {
          "input": "FoldList[Max, List[1, 2, 3, 4]]",
          "output": "{1, 2, 3, 4}",
          "verdict": "agree",
          "tex": {
            "input": "\\text{FoldList}[\\text{Max},\\{1,2,3,4\\}]",
            "output": "\\{1,2,3,4\\}"
          }
        }
      },
      "the-seeded-form-is-still-the-same-length-as-xs": {
        "wolfram": {
          "input": "enumeratio`Scan[List[1, 2, 3], Plus, 10]",
          "output": "enumeratio`Scan[{1, 2, 3}, Plus, 10]",
          "verdict": "disagree",
          "kind": "convention",
          "note": "Wolfram's seeded FoldList keeps the seed (length+1), so the seeded Scan has no Wolfram form.",
          "tex": {
            "input": "\\text{enumeratio$\\grave{ }$Scan}(\\{1,2,3\\},\\text{Plus},10)",
            "output": "\\text{enumeratio$\\grave{ }$Scan}(\\{1,2,3\\},\\text{Plus},10)"
          }
        }
      }
    },
    "Contains": {
      "contains-list-1-2-3-2": {
        "wolfram": {
          "input": "MemberQ[List[1, 2, 3], 2]",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MemberQ}[\\{1,2,3\\},2]",
            "output": "\\text{True}"
          }
        }
      },
      "contains-list-1-2-3-5": {
        "wolfram": {
          "input": "MemberQ[List[1, 2, 3], 5]",
          "output": "False",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MemberQ}[\\{1,2,3\\},5]",
            "output": "\\text{False}"
          }
        }
      }
    },
    "Unique": {
      "unique-list-1-2-2-3-1": {
        "wolfram": {
          "input": "DeleteDuplicates[List[1, 2, 2, 3, 1]]",
          "output": "{1, 2, 3}",
          "verdict": "agree",
          "tex": {
            "input": "\\text{DeleteDuplicates}[\\{1,2,2,3,1\\}]",
            "output": "\\{1,2,3\\}"
          }
        }
      }
    }
  }
}
