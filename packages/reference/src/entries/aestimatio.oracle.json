{
  "kernels": {
    "sage": "SageMath version 10.9, Release Date: 2026-05-04",
    "wolfram": "15.0.0 for Mac OS X ARM (64-bit) (May 26, 2026)"
  },
  "examples": {
    "TimeConstrained": {
      "[\"TimeConstrained\",[\"Sum\",\"k\",[\"Tuple\",\"k\",1,10]],1]": {
        "wolfram": {
          "input": "TimeConstrained[Sum[k, List[k, 1, 10]], 1]",
          "output": "55",
          "verdict": "agree",
          "tex": {
            "input": "\\text{TimeConstrained}\\left[\\sum _{k=1}^{10} k,1\\right]",
            "output": "55"
          }
        }
      }
    },
    "MemoryConstrained": {
      "[\"MemoryConstrained\",[\"Add\",1,2],1000000]": {
        "wolfram": {
          "input": "MemoryConstrained[Plus[1, 2], 1000000]",
          "output": "3",
          "verdict": "disagree",
          "kind": "unevaluated",
          "note": "In-process, MemoryConstrained stays unevaluated because JavaScript cannot cap a synchronous computation's memory; Wolfram enforces the cap and evaluates 1 + 2 = 3.",
          "tex": {
            "input": "\\text{MemoryConstrained}[1+2,1000000]",
            "output": "3"
          }
        }
      }
    },
    "VerificationTest": {
      "[\"VerificationTest\",[\"Add\",2,3],5]": {
        "wolfram": {
          "input": "VerificationTest[Plus[2, 3], 5]",
          "output": "TestObject[<|\"Outcome\" -> \"Success\", \"Input\" -> HoldForm[2 + 3], \"ExpectedOutput\" -> HoldForm[5], \"ActualOutput\" -> HoldForm[5]|>]",
          "verdict": "disagree",
          "kind": "convention",
          "note": "Same outcome, different record: ours is a TestResultObject of rules with Input evaluated; Wolfram returns a TestObject association with Input held (the scan keeps only its Outcome/Input/ExpectedOutput/ActualOutput).",
          "tex": {
            "input": "\\text{VerificationTest}[2+3,5]",
            "output": "\\text{TestObject}[\\unicode{f113}\\text{Outcome}\\to \\text{Success},\\text{Input}\\to 2+3,\\text{ExpectedOutput}\\to 5,\\text{ActualOutput}\\to 5\\unicode{f114}]"
          }
        }
      },
      "[\"VerificationTest\",[\"Add\",2,3],6]": {
        "wolfram": {
          "input": "VerificationTest[Plus[2, 3], 6]",
          "output": "TestObject[<|\"Outcome\" -> \"Failure\", \"Input\" -> HoldForm[2 + 3], \"ExpectedOutput\" -> HoldForm[6], \"ActualOutput\" -> HoldForm[5]|>]",
          "verdict": "disagree",
          "kind": "convention",
          "note": "Same outcome, different record: ours is a TestResultObject of rules with Input evaluated; Wolfram returns a TestObject association with Input held (the scan keeps only its Outcome/Input/ExpectedOutput/ActualOutput).",
          "tex": {
            "input": "\\text{VerificationTest}[2+3,6]",
            "output": "\\text{TestObject}[\\unicode{f113}\\text{Outcome}\\to \\text{Failure},\\text{Input}\\to 2+3,\\text{ExpectedOutput}\\to 6,\\text{ActualOutput}\\to 5\\unicode{f114}]"
          }
        }
      }
    }
  }
}
