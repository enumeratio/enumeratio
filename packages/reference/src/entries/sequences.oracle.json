      "threads-element-wise-over-a-list-as-wolfram-s": {
        "wolfram": {
          "input": "Fibonacci[List[1, 2, 3, 4]]",
          "output": "{1, 1, 2, 3}",
          "verdict": "agree",
          "tex": {
            "input": "F_{\\{1,2,3,4\\}}",
            "output": "\\{1,1,2,3\\}"
          }
        },
        "sympy": {
          "input": "fibonacci([1, 2, 3, 4])",
          "output": "AttributeError: 'list' object has no attribute 'is_Integer'",
          "verdict": "error",
          "kind": "threading",
          "note": "compute-engine's Fibonacci is Listable and threads over the list; SymPy's takes scalars only."
        }
      },
