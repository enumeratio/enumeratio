      "the-defining-recurrence-f-10-f-9-f-8": {
        "wolfram": {
          "input": "(Fibonacci[10] == Plus[Fibonacci[9], Fibonacci[8]])",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "F_{10}=F_9+F_8",
            "output": "\\text{True}"
          }
        },
        "sage": {
          "input": "bool(fibonacci(10) == (fibonacci(9) + fibonacci(8)))",
          "output": "True",
          "verdict": "agree"
        },
        "julia": {
          "input": "(fibonacci(10) == (fibonacci(9) + fibonacci(8)))",
          "output": "true",
          "verdict": "agree"
        },
        "mathlib4": {
          "input": "(decide ((Nat.fib 10) = ((Nat.fib 9) + (Nat.fib 8))))",
          "output": "true",
          "verdict": "agree"
        },
        "oscar": {
          "input": "(fibonacci(10) == (fibonacci(9) + fibonacci(8)))",
          "output": "true",
          "verdict": "agree"
        },
        "sympy": {
          "input": "enumeratio_equal(fibonacci(10), (fibonacci(9) + fibonacci(8)))",
          "output": "True",
          "verdict": "agree"
        }
      },
      "cassini-s-identity-f-n-1-f-n-1-f-n-2-1-n-here-at": {
        "wolfram": {
          "input": "Subtract[Times[Fibonacci[5], Fibonacci[7]], Power[Fibonacci[6], 2]]",
          "output": "1",
          "verdict": "agree",
          "tex": {
            "input": "F_5 F_7-\\left(F_6\\right){}^2",
            "output": "1"
          }
        },
        "sage": {
          "input": "((fibonacci(5) * fibonacci(7)) - (fibonacci(6)^2))",
          "output": "1",
          "verdict": "agree"
        },
        "julia": {
          "input": "((fibonacci(5) * fibonacci(7)) - (big(fibonacci(6))^2))",
          "output": "1",
          "verdict": "agree"
        },
        "mathlib4": {
          "input": "(((Nat.fib 5) * (Nat.fib 7)) - ((Nat.fib 6) ^ 2))",
          "output": "1",
          "verdict": "agree"
        },
        "oscar": {
          "input": "((fibonacci(5) * fibonacci(7)) - (big(fibonacci(6))^2))",
          "output": "1",
          "verdict": "agree"
        },
        "sympy": {
          "input": "((fibonacci(5) * fibonacci(7)) - (fibonacci(6)**2))",
          "output": "1",
          "verdict": "agree"
        }
      },
      "gcd-f-12-f-18-f-gcd-12-18": {
        "wolfram": {
          "input": "(GCD[Fibonacci[12], Fibonacci[18]] == Fibonacci[GCD[12, 18]])",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "\\gcd \\left(F_{12},F_{18}\\right)=F_{\\gcd (12,18)}",
            "output": "\\text{True}"
          }
        },
        "sage": {
          "input": "bool(gcd(fibonacci(12), fibonacci(18)) == fibonacci(gcd(12, 18)))",
          "output": "True",
          "verdict": "agree"
        },
        "julia": {
          "input": "(gcd(ZZ(fibonacci(12)), ZZ(fibonacci(18))) == fibonacci(gcd(ZZ(12), ZZ(18))))",
          "output": "true",
          "verdict": "agree"
        },
        "mathlib4": {
          "input": "(decide ((Int.gcd (Nat.fib 12) (Nat.fib 18)) = (Nat.fib (Int.gcd 12 18))))",
          "output": "true",
          "verdict": "agree"
        },
        "oscar": {
          "input": "(gcd(ZZ(fibonacci(12)), ZZ(fibonacci(18))) == fibonacci(gcd(ZZ(12), ZZ(18))))",
          "output": "true",
          "verdict": "agree"
        },
        "sympy": {
          "input": "enumeratio_equal(gcd(fibonacci(12), fibonacci(18)), fibonacci(gcd(12, 18)))",
          "output": "True",
          "verdict": "agree"
        }
      },
