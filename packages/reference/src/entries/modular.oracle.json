{
  "kernels": {
    "wolfram": "15.0.0 for Mac OS X ARM (64-bit) (May 26, 2026)",
    "sage": "SageMath version 10.9, Release Date: 2026-05-04"
  },
  "examples": {
    "ContinuedFraction": {
      "pi-s-famous-convergent": {
        "wolfram": {
          "input": "ContinuedFraction[Rational[355, 113]]",
          "output": "{3, 7, 16}",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ContinuedFraction}\\left[\\frac{355}{113}\\right]",
            "output": "\\{3,7,16\\}"
          }
        },
        "sage": {
          "input": "list(continued_fraction((355/113)))",
          "output": "[3, 7, 16]",
          "verdict": "agree"
        },
        "sympy": {
          "input": "list(continued_fraction(Rational(355, 113)))",
          "output": "[3, 7, 16]",
          "verdict": "agree"
        }
      }
    },
    "ModularMatrix": {
      "words-multiply-their-matrices": {
        "wolfram": {
          "input": "Dot[\"L\", \"R\"]",
          "output": "\"L\" . \"R\"",
          "verdict": "disagree",
          "kind": "domain",
          "note": "An LR word is an enumeratio spelling of a PSL(2,Z) element; Wolfram's Dot has no reading for two strings and leaves the call unevaluated.",
          "tex": {
            "input": "\\text{L}.\\text{R}",
            "output": "\\text{L}.\\text{R}"
          }
        }
      }
    }
  }
}
