{
  "kernels": {
    "wolfram": "15.0.0 for Mac OS X ARM (64-bit) (May 26, 2026)",
    "sage": "SageMath version 10.9, Release Date: 2026-05-04"
  },
  "examples": {
    "GroupBasis": {
      "2-5-7-equiv-1": {
        "oscar": {
          "input": "enumeratio_product(enumeratio_cyclic(cyclic_group(PermGroup, 6), 6), EnumeratioBasis(\"2\"), EnumeratioBasis(\"5\"))",
          "output": "combination:{\"GroupBasis(1)\":1}",
          "verdict": "agree"
        }
      },
      "s-2-1": {
        "oscar": {
          "input": "enumeratio_product(enumeratio_dihedral(dihedral_group(PermGroup, 2 * 4), 4), EnumeratioBasis(\"s0\"), EnumeratioBasis(\"s0\"))",
          "output": "combination:{\"GroupBasis(0)\":1}",
          "verdict": "agree"
        }
      },
      "d-4-8": {
        "oscar": {
          "input": "dim((enumeratio_dihedral(dihedral_group(PermGroup, 2 * 4), 4)).A)",
          "output": "8",
          "verdict": "agree"
        }
      },
      "so-k-d-4-is-not-commutative-either": {
        "oscar": {
          "input": "is_abelian((enumeratio_dihedral(dihedral_group(PermGroup, 2 * 4), 4)).G)",
          "output": "false",
          "verdict": "agree"
        }
      }
    },
    "ClassSum": {
      "the-identity-s-class-is-a-singleton": {
        "oscar": {
          "input": "enumeratio_class_sum(enumeratio_dihedral(dihedral_group(PermGroup, 2 * 3), 3), 1)",
          "output": "combination:{\"GroupBasis(0)\":1}",
          "verdict": "agree"
        }
      },
      "class-sums-are-central": {
        "oscar": {
          "input": "enumeratio_is_central(enumeratio_dihedral(dihedral_group(PermGroup, 2 * 3), 3), enumeratio_class_sum(enumeratio_dihedral(dihedral_group(PermGroup, 2 * 3), 3), 2))",
          "output": "true",
          "verdict": "agree"
        }
      },
      "a-lone-reflection-is-not": {
        "oscar": {
          "input": "enumeratio_is_central(enumeratio_dihedral(dihedral_group(PermGroup, 2 * 3), 3), EnumeratioBasis(\"s0\"))",
          "output": "false",
          "verdict": "agree"
        }
      },
      "in-an-abelian-group-everything-is-central": {
        "oscar": {
          "input": "enumeratio_is_central(enumeratio_cyclic(cyclic_group(PermGroup, 6), 6), EnumeratioBasis(\"3\"))",
          "output": "true",
          "verdict": "agree"
        }
      }
    },
    "ConjugacyClasses": {
      "abelian-one-class-per-element": {
        "oscar": {
          "input": "number_of_conjugacy_classes((enumeratio_cyclic(cyclic_group(PermGroup, 6), 6)).G)",
          "output": "6",
          "verdict": "agree"
        }
      },
      "d-3-cong-s-3": {
        "oscar": {
          "input": "number_of_conjugacy_classes((enumeratio_dihedral(dihedral_group(PermGroup, 2 * 3), 3)).G)",
          "output": "3",
          "verdict": "agree"
        }
      },
      "4-6-2": {
        "oscar": {
          "input": "number_of_conjugacy_classes((enumeratio_dihedral(dihedral_group(PermGroup, 2 * 4), 4)).G)",
          "output": "5",
          "verdict": "agree"
        }
      },
      "direct-products-work-too": {
        "oscar": {
          "input": "order((enumeratio_direct_product(enumeratio_cyclic(cyclic_group(PermGroup, 2), 2), enumeratio_cyclic(cyclic_group(PermGroup, 3), 3))).G)",
          "output": "6",
          "verdict": "agree"
        }
      }
    }
  }
}
