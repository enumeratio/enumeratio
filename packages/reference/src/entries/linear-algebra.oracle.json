{
  "kernels": {
    "wolfram": "15.0.0 for Mac OS X ARM (64-bit) (May 26, 2026)",
    "sage": "SageMath version 10.9, Release Date: 2026-05-04"
  },
  "examples": {
    "Rank": {
      "rank-5": {
        "wolfram": {
          "input": "ArrayDepth[5]",
          "output": "0",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ArrayDepth}[5]",
            "output": "0"
          }
        }
      },
      "rank-list-1-2-3": {
        "wolfram": {
          "input": "ArrayDepth[List[1, 2, 3]]",
          "output": "1",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ArrayDepth}[\\{1,2,3\\}]",
            "output": "1"
          }
        }
      },
      "rank-list-list-1-0-list-0-1": {
        "wolfram": {
          "input": "ArrayDepth[List[List[1, 0], List[0, 1]]]",
          "output": "2",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ArrayDepth}\\left[\\left( \\begin{array}{cc}  1 & 0 \\\\  0 & 1 \\\\ \\end{array} \\right)\\right]",
            "output": "2"
          }
        }
      },
      "rank-list-list-list-1-2-list-3-4-list-list-5-6": {
        "wolfram": {
          "input": "ArrayDepth[List[List[List[1, 2], List[3, 4]], List[List[5, 6], List[7, 8]]]]",
          "output": "3",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ArrayDepth}\\left[\\left( \\begin{array}{cc}  \\{1,2\\} & \\{3,4\\} \\\\  \\{5,6\\} & \\{7,8\\} \\\\ \\end{array} \\right)\\right]",
            "output": "3"
          }
        }
      },
      "the-length-of-the-array-s-shape": {
        "wolfram": {
          "input": "(ArrayDepth[List[List[List[1, 2], List[3, 4]], List[List[5, 6], List[7, 8]]]] == Length[Dimensions[List[List[List[1, 2], List[3, 4]], List[List[5, 6], List[7, 8]]]]])",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ArrayDepth}\\left[\\left( \\begin{array}{cc}  \\{1,2\\} & \\{3,4\\} \\\\  \\{5,6\\} & \\{7,8\\} \\\\ \\end{array} \\right)\\right]=\\text{Length}\\left[\\text{Dimensions}\\left[\\left( \\begin{array}{cc}  \\{1,2\\} & \\{3,4\\} \\\\  \\{5,6\\} & \\{7,8\\} \\\\ \\end{array} \\right)\\right]\\right]",
            "output": "\\text{True}"
          }
        }
      },
      "a-singular-2-2-matrix-still-has-rank-2-its": {
        "wolfram": {
          "input": "ArrayDepth[List[List[1, 2], List[2, 4]]]",
          "output": "2",
          "verdict": "agree",
          "tex": {
            "input": "\\text{ArrayDepth}\\left[\\left( \\begin{array}{cc}  1 & 2 \\\\  2 & 4 \\\\ \\end{array} \\right)\\right]",
            "output": "2"
          }
        }
      }
    },
    "MatrixRank": {
      "matrixrank-list-list-1-0-list-0-1": {
        "wolfram": {
          "input": "MatrixRank[List[List[1, 0], List[0, 1]]]",
          "output": "2",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MatrixRank}\\left[\\left( \\begin{array}{cc}  1 & 0 \\\\  0 & 1 \\\\ \\end{array} \\right)\\right]",
            "output": "2"
          }
        }
      },
      "matrixrank-list-list-1-2-list-2-4": {
        "wolfram": {
          "input": "MatrixRank[List[List[1, 2], List[2, 4]]]",
          "output": "1",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MatrixRank}\\left[\\left( \\begin{array}{cc}  1 & 2 \\\\  2 & 4 \\\\ \\end{array} \\right)\\right]",
            "output": "1"
          }
        }
      },
      "matrixrank-list-list-1-2-3-list-4-5-6-list-7-8-9": {
        "wolfram": {
          "input": "MatrixRank[List[List[1, 2, 3], List[4, 5, 6], List[7, 8, 9]]]",
          "output": "2",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MatrixRank}\\left[\\left( \\begin{array}{ccc}  1 & 2 & 3 \\\\  4 & 5 & 6 \\\\  7 & 8 & 9 \\\\ \\end{array} \\right)\\right]",
            "output": "2"
          }
        }
      },
      "non-square-matrices-too": {
        "wolfram": {
          "input": "MatrixRank[List[List[1, 2, 3], List[2, 4, 6]]]",
          "output": "1",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MatrixRank}\\left[\\left( \\begin{array}{ccc}  1 & 2 & 3 \\\\  2 & 4 & 6 \\\\ \\end{array} \\right)\\right]",
            "output": "1"
          }
        }
      },
      "matrixrank-list-list-0-0-list-0-0": {
        "wolfram": {
          "input": "MatrixRank[List[List[0, 0], List[0, 0]]]",
          "output": "0",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MatrixRank}\\left[\\left( \\begin{array}{cc}  0 & 0 \\\\  0 & 0 \\\\ \\end{array} \\right)\\right]",
            "output": "0"
          }
        }
      },
      "row-rank-equals-column-rank": {
        "wolfram": {
          "input": "(MatrixRank[List[List[1, 2, 3], List[4, 5, 6], List[7, 8, 9]]] == MatrixRank[Transpose[List[List[1, 2, 3], List[4, 5, 6], List[7, 8, 9]]]])",
          "output": "True",
          "verdict": "agree",
          "tex": {
            "input": "\\text{MatrixRank}\\left[\\left( \\begin{array}{ccc}  1 & 2 & 3 \\\\  4 & 5 & 6 \\\\  7 & 8 & 9 \\\\ \\end{array} \\right)\\right]=\\text{MatrixRank}\\left[\\left( \\begin{array}{ccc}  1 & 2 & 3 \\\\  4 & 5 & 6 \\\\  7 & 8 & 9 \\\\ \\end{array} \\right)^T\\right]",
            "output": "\\text{True}"
          }
        }
      },
      "a-vector-is-treated-as-a-1-n-matrix-wolfram": {
        "wolfram": {
          "input": "MatrixRank[List[1, 2, 3]]",
          "output": "MatrixRank[{1, 2, 3}]",
          "verdict": "disagree",
          "kind": "domain",
          "note": "Wolfram declines a vector (not a matrix); compute-engine reads it as 1×n.",
          "tex": {
            "input": "\\text{MatrixRank}[\\{1,2,3\\}]",
            "output": "\\text{MatrixRank}[\\{1,2,3\\}]"
          }
        }
      }
    }
  }
}
