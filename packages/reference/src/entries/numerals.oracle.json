    "AdicNumeral": {
      "[\"Multiply\",[\"AdicNumeral\",10,[\"Rational\",1,3]],3]": {
        "rust": {
          "input": "(adic(n(10), rational(n(1), n(3))) * n(3))",
          "output": "panic: the adic crate takes a prime base, not 10",
          "verdict": "error",
          "kind": "domain",
          "note": "The adic crate is p-adic only; our composite (10-adic) numerals have no counterpart there."
