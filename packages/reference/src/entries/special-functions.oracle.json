  "examples": {
    "Gamma": {
      "[\"Gamma\",0]": {
        "wolfram": {
          "input": "Gamma[0]",
          "output": "ComplexInfinity",
          "verdict": "agree"
        },
        "sage": {
          "input": "gamma(0)",
          "output": "Infinity",
          "verdict": "disagree",
          "kind": "undefined-form",
          "note": "The pole is ComplexInfinity here; Sage's gamma(0) spells the same pole 'Infinity' (unsigned), a different notation for the same undefined value."
        }
      },
      "[\"Gamma\",2.5]": {
        "wolfram": {
          "input": "Gamma[2.5]",
          "output": "1.329340388179137",
          "verdict": "agree"
        },
        "sage": {
          "input": "gamma(2.5)",
          "output": "1.32934038817914",
          "verdict": "agree"
        }
      },
      "[\"Gamma\",[\"List\",0,-1]]": {
        "wolfram": {
          "input": "Gamma[List[0, -1]]",
          "output": "{ComplexInfinity, ComplexInfinity}",
          "verdict": "agree"
        },
        "sage": {
          "input": "gamma([0, -1])",
          "output": "TypeError: cannot coerce arguments: no canonical coercion from <class 'list'> to Symbolic Ring",
          "verdict": "error",
          "kind": "threading",
          "note": "compute-engine's Gamma is Listable and threads over the list; Sage's takes scalars only."
        }
      },
      "[\"Equal\",[\"Gamma\",6],[\"Factorial\",5]]": {
        "wolfram": {
          "input": "(Gamma[6] == Factorial[5])",
          "output": "True",
          "verdict": "agree"
        },
        "sage": {
          "input": "bool(gamma(6) == factorial(5))",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Equal\",[\"Gamma\",6],[\"Multiply\",5,[\"Gamma\",5]]]": {
        "wolfram": {
          "input": "(Gamma[6] == Times[5, Gamma[5]])",
          "output": "True",
          "verdict": "agree"
        },
        "sage": {
          "input": "bool(gamma(6) == (5 * gamma(5)))",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Equal\",[\"Multiply\",[\"Gamma\",[\"Rational\",1,3]],[\"Gamma\",[\"Rational\",2,3]]],[\"Divide\",\"Pi\",[\"Sin\",[\"Divide\",\"Pi\",3]]]]": {
        "wolfram": {
          "input": "(Times[Gamma[Rational[1, 3]], Gamma[Rational[2, 3]]] == Divide[Pi, Sin[Divide[Pi, 3]]])",
          "output": "Gamma[1/3]*Gamma[2/3] == (2*Pi)/Sqrt[3]",
          "verdict": "agree"
        },
        "sage": {
          "input": "bool((gamma((1/3)) * gamma((2/3))) == (pi / sin((pi / 3))))",
          "output": "False",
          "verdict": "disagree",
          "kind": "convention",
          "note": "True by the reflection formula; Sage's bool(a==b) doesn't invoke that identity automatically on unevaluated symbolic Gammas and reports False instead of attempting the proof."
        }
      },
      "[\"Equal\",[\"Gamma\",[\"Rational\",1,2]],[\"Sqrt\",\"Pi\"]]": {
        "wolfram": {
          "input": "(Gamma[Rational[1, 2]] == Sqrt[Pi])",
          "output": "True",
          "verdict": "agree"
        },
        "sage": {
          "input": "bool(gamma((1/2)) == sqrt(pi))",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Equal\",[\"Divide\",[\"Power\",\"Pi\",2],[\"Gamma\",3]],[\"Divide\",[\"Power\",\"Pi\",2],2]]": {
        "wolfram": {
          "input": "(Divide[Power[Pi, 2], Gamma[3]] == Divide[Power[Pi, 2], 2])",
          "output": "True",
          "verdict": "agree"
        },
        "sage": {
          "input": "bool(((pi^2) / gamma(3)) == ((pi^2) / 2))",
          "output": "True",
          "verdict": "agree"
        }
      },
      "[\"Gamma\",[\"Rational\",5,2]]": {
