    "Diagram": {
      "[\"NonCommutativeMultiply\",[\"Diagram\",[\"List\",[\"List\",1,2],[\"List\",-1,-2]]],[\"Diagram\",[\"List\",[\"List\",1,2],[\"List\",-1,-2]]]]": {
        "sage": {
          "input": "(enumeratio_diagram([[1, 2], [-1, -2]]) * enumeratio_diagram([[1, 2], [-1, -2]]))",
          "output": "delta*P{{-2, -1}, {1, 2}}",
          "verdict": "agree"
        }
      },
      "[\"NonCommutativeMultiply\",[\"Diagram\",[\"List\",[\"List\",1,2],[\"List\",-1,-2],[\"List\",3,-3]]],[\"Diagram\",[\"List\",[\"List\",2,3],[\"List\",-2,-3],[\"List\",1,-1]]],[\"Diagram\",[\"List\",[\"List\",1,2],[\"List\",-1,-2],[\"List\",3,-3]]]]": {
        "sage": {
          "input": "(enumeratio_diagram([[1, 2], [-1, -2], [3, -3]]) * enumeratio_diagram([[2, 3], [-2, -3], [1, -1]]) * enumeratio_diagram([[1, 2], [-1, -2], [3, -3]]))",
          "output": "P{{-3, 3}, {-2, -1}, {1, 2}}",
          "verdict": "agree"
        }
      },
      "[\"Diagram\",[\"List\",[\"List\",-1,-2],[\"List\",3,-3],[\"List\",1,2]]]": {
        "sage": {
          "input": "enumeratio_diagram([[-1, -2], [3, -3], [1, 2]])",
          "output": "P{{-3, 3}, {-2, -1}, {1, 2}}",
          "verdict": "agree"
        }
      },
      "[\"Diagram\",[\"List\",[\"List\",1,-1],[\"List\",2]]]": {
        "sage": {
          "input": "enumeratio_diagram([[1, -1], [2]])",
          "output": "P{{-2}, {-1, 1}, {2}}",
          "verdict": "disagree",
          "kind": "domain",
          "note": "Sage completes a diagram missing a point by adding it as a singleton block; ours leaves a malformed diagram as written."
        }
      }
    },
