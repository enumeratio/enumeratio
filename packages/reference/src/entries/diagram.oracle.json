  "examples": {
    "Diagram": {
      "the-cup-cap-squared-closes-one-loop-e-1-2-delta": {
        "sage": {
          "input": "(enumeratio_diagram([[1, 2], [-1, -2]]) * enumeratio_diagram([[1, 2], [-1, -2]]))",
          "output": "delta*P{{-2, -1}, {1, 2}}",
          "verdict": "agree"
        }
      },
      "e-1e-2e-1-e-1-with-no-loop-closed": {
        "sage": {
          "input": "(enumeratio_diagram([[1, 2], [-1, -2], [3, -3]]) * enumeratio_diagram([[2, 3], [-2, -3], [1, -1]]) * enumeratio_diagram([[1, 2], [-1, -2], [3, -3]]))",
          "output": "P{{-3, 3}, {-2, -1}, {1, 2}}",
          "verdict": "agree"
        }
      },
      "blocks-come-back-in-canonical-order": {
        "sage": {
          "input": "enumeratio_diagram([[-1, -2], [3, -3], [1, 2]])",
          "output": "P{{-3, 3}, {-2, -1}, {1, 2}}",
          "verdict": "agree"
        }
      },
      "malformed-the-point-2-is-missing-so-it-is-left": {
        "sage": {
          "input": "enumeratio_diagram([[1, -1], [2]])",
          "output": "P{{-2}, {-1, 1}, {2}}",
          "verdict": "disagree",
          "kind": "domain",
          "note": "Sage completes a diagram missing a point by adding it as a singleton block; ours leaves a malformed diagram as written."
        }
      }
    },
