          "verdict": "agree",
          "tex": {
            "input": "\\text{Length}[\\{1,2,3\\}\\cup \\{2,3,4\\}]=(\\text{Length}[\\{1,2,3\\}]+\\text{Length}[\\{2,3,4\\}])-\\text{Length}[\\{1,2,3\\}\\cap \\{2,3,4\\}]",
