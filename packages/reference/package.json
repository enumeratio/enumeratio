{
  "name": "@enumeratio/reference",
  "version": "0.0.0",
  "private": true,
  "description": "Structured, verified example data for compute-engine functions — the single source for reference pages and their tests.",
  "license": "WTFPL",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
