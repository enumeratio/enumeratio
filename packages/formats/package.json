{
  "name": "@enumeratio/formats",
  "version": "0.0.0",
  "private": true,
  "description": "A Wolfram-style format registry with Import/Export over MathJSON, Wolfram, TeX, code, and image formats.",
  "license": "WTFPL",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./src": "./src/index.ts",
    "./inputform": {
      "types": "./dist/inputform.d.mts",
      "import": "./dist/inputform.mjs"
    },
    "./mathml": {
      "types": "./dist/mathml.d.mts",
      "import": "./dist/mathml.mjs"
    },
    "./tex": {
      "types": "./dist/tex.d.mts",
      "import": "./dist/tex.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./expression": {
      "types": "./dist/expression.d.mts",
      "import": "./dist/expression.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/node.ts src/expression.ts src/inputform.ts src/mathml.ts src/tex.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxed": "workspace:*",
    "@enumeratio/raster": "workspace:*",
    "@enumeratio/wolfram": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.134.0",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.134.0"
  }
}
