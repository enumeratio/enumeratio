{
  "name": "@enumeratio/cli",
  "version": "0.0.0",
  "private": true,
  "description": "notatio on the command line: a Wolfram-style REPL and one-shot evaluator for compute-engine with the enumeratio symbols declared.",
  "license": "WTFPL",
  "bin": {
    "notatio": "./bin/notatio.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": "./dist/browser.mjs",
    "./command": "./dist/command.mjs",
    "./completion": "./dist/completion.mjs",
    "./engine": "./dist/engine.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/browser.ts src/command.ts src/completion.ts src/engine.ts",
    "dev": "vp pack src/index.ts src/browser.ts src/command.ts src/completion.ts src/engine.ts --watch",
    "start": "tsx src/main.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.151.0",
    "@enumeratio/analytic": "workspace:*",
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/braid": "workspace:*",
    "@enumeratio/combinatorics": "workspace:*",
    "@enumeratio/diagram": "workspace:*",
    "@enumeratio/evaluation": "workspace:*",
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/frontend": "workspace:*",
    "@enumeratio/groupalgebra": "workspace:*",
    "@enumeratio/hecke": "workspace:*",
    "@enumeratio/hopf": "workspace:*",
    "@enumeratio/hypercomplex": "workspace:*",
    "@enumeratio/incidence": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/modular": "workspace:*",
    "@enumeratio/number-theory": "workspace:*",
    "@enumeratio/numerals": "workspace:*",
    "@enumeratio/quiver": "workspace:*",
    "@enumeratio/raster": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "@enumeratio/statistics": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@enumeratio/config": "workspace:*",
    "@types/node": "^24",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "enumeratio": {
    "layer": "presentation",
    "extends": []
  }
}
