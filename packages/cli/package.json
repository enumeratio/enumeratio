{
  "name": "@enumeratio/cli",
  "version": "0.0.0",
  "private": true,
  "description": "notatio on the command line: a Wolfram-style REPL and one-shot evaluator for compute-engine with the enumeratio symbols declared.",
  "license": "WTFPL",
  "bin": {
    "notatio": "./bin/notatio.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": "./dist/browser.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/browser.ts --no-dts",
    "dev": "vp pack src/index.ts src/browser.ts --no-dts --watch",
    "start": "tsx src/main.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.134.0",
    "@enumeratio/collections": "workspace:*",
    "@enumeratio/domains": "workspace:*",
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/notatio": "workspace:*",
    "@enumeratio/raster": "workspace:*",
    "@enumeratio/statistics": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
