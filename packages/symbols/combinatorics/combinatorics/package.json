{
  "name": "@enumeratio/combinatorics",
  "version": "0.0.0",
  "private": true,
  "description": "Combinatorial collections and carriers for @cortex-js/compute-engine, merged wholesale ahead of per-area carving (https://github.com/enumeratio/enumeratio/wiki/Speculative-Combinatorics-Layering-and-Plausible).",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./findstat": {
      "types": "./dist/findstat.d.mts",
      "import": "./dist/findstat.mjs"
    },
    "./collections": {
      "types": "./dist/collections.d.mts",
      "import": "./dist/collections.mjs"
    },
    "./collections/sampleable": {
      "types": "./dist/sampleable.d.mts",
      "import": "./dist/sampleable.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-generated.ts && node ../../../manifest/scripts/cached.ts pack dist -- vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/plausible": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.151.0",
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/groupalgebra": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "@enumeratio/structures": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.151.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "combinatorics",
    "extends": [
      "structures",
      "residues",
      "groupalgebra"
    ],
    "notation": "./notation",
    "group": "combinatorics",
    "declare": "declareCombinatorics",
    "names": [
      "CombinatorialStat",
      "Tally"
    ],
    "late": "declareLate",
    "reads": [
      "../statistics/reference"
    ],
    "declares": "./declares.json"
  },
  "generated": [
    "src/statistics/naming-data.ts",
    "src/maps-laws.generated.ts",
    "src/compiled-maps.generated.js"
  ]
}
