{
  "name": "@enumeratio/statistics",
  "version": "0.0.0",
  "private": true,
  "description": "Probability distributions and random processes, defined as Epsil expressions.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node ../../../manifest/scripts/collect-declares.ts .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/engine": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "@enumeratio/combinatorics": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "combinatorics",
    "extends": [],
    "group": "combinatorics",
    "declare": [
      "declareDistributions",
      "declareDistributions2",
      "declareDistributions3",
      "declareDistributions4",
      "declareDistributions5",
      "declareDistributions6",
      "declareProcesses"
    ],
    "declares": "./declares.json",
    "requires": [
      "combinatorics"
    ]
  }
}
