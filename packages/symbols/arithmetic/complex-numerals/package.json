{
  "name": "@enumeratio/complex-numerals",
  "version": "0.0.0",
  "private": true,
  "description": "Numbers written in a complex base: radix expansions over the Gaussian and Eisenstein integers (twindragon, quater-imaginary, Gosper island), as lattices to draw.",
  "license": "WTFPL",
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./lattice": {
      "types": "./dist/lattice.d.mts",
      "import": "./dist/lattice.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/numerals": "workspace:*"
  },
  "devDependencies": {
    "@enumeratio/config": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "arithmetic",
    "extends": [
      "numerals"
    ],
    "group": "arithmetic",
    "declare": "declareComplexNumerals"
  }
}
