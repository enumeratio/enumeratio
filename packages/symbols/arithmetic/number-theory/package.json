{
  "name": "@enumeratio/number-theory",
  "version": "0.0.0",
  "private": true,
  "description": "Number theory past Z/m for @cortex-js/compute-engine: Gaussian integers, rational reconstruction, Hermite normal form and integer valuations, all over bigints.",
  "license": "WTFPL",
  "files": [
    "dist",
    "docs",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./lattice": {
      "types": "./dist/lattice.d.mts",
      "import": "./dist/lattice.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/numerals": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.150.0",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/numerals": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.150.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "arithmetic",
    "extends": [
      "numerals"
    ],
    "notation": "./notation",
    "group": "arithmetic",
    "declare": "declareNumberTheory",
    "declares": "./declares.json"
  }
}
