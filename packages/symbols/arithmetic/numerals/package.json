{
  "name": "@enumeratio/numerals",
  "version": "0.0.0",
  "private": true,
  "description": "Numeral-system extensions for @cortex-js/compute-engine: IntegerDigits/FromDigits over radix, mixed-radix, factoradic, balanced, negative, bijective, Zeckendorf, combinatorial and residue systems.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/oracle": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
    "notation": "./notation",
    "group": "arithmetic",
    "declare": "declareNumerals"
  }
}
