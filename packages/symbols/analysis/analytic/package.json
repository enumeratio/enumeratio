    },
    "./definitions": {
      "types": "./dist/definitions.d.mts",
      "import": "./dist/definitions.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./shader": {
      "types": "./dist/shader.d.mts",
      "import": "./dist/shader.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/collect-notation.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/engine": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/oracle": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
