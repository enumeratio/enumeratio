{
  "name": "@enumeratio/analytic",
  "version": "0.0.0",
  "private": true,
  "description": "Analytic / special-function extensions for @cortex-js/compute-engine — Hurwitz zeta and friends. Separate from the combinatorial collections.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./definitions": {
      "types": "./dist/definitions.d.mts",
      "import": "./dist/definitions.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./shader": {
      "types": "./dist/shader.d.mts",
      "import": "./dist/shader.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "enumeratio-collect-notation . && vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/engine": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.148.0",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/structures": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.148.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "analysis",
    "extends": [
      "structures"
    ],
    "notation": "./notation",
    "group": "analysis",
    "declare": [
      "declareAnalytic",
      "declareFractals"
    ],
    "declares": "./declares.json"
  },
  "generated": [
    "src/notation.generated.ts"
  ]
}
