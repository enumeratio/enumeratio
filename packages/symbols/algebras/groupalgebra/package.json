{
  "name": "@enumeratio/groupalgebra",
  "version": "0.0.0",
  "private": true,
  "description": "Group-algebra extensions for @cortex-js/compute-engine: cyclic, dihedral and product groups, their group algebras, conjugacy classes and centres.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "enumeratio-collect-notation . && vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.150.0",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/structures": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.150.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "algebras",
    "extends": [
      "structures"
    ],
    "notation": "./notation",
    "group": "algebras",
    "declare": "declareGroupAlgebra",
    "declares": "./declares.json"
  },
  "generated": [
    "src/notation.generated.ts"
  ]
}
