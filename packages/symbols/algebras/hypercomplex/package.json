{
  "name": "@enumeratio/hypercomplex",
  "version": "0.0.0",
  "private": true,
  "description": "Hypercomplex-number extensions for @cortex-js/compute-engine — multicomplex, split/perplex, dual and Clifford unit families as ordinary subscripted symbols.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.150.0",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/structures": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.150.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "algebras",
    "extends": [
      "structures"
    ],
    "notation": "./notation",
    "group": "algebras",
    "declare": "declareHypercomplex",
    "names": [
      "CircleTimes",
      "GeometricProduct"
    ],
    "declares": "./declares.json"
  }
}
