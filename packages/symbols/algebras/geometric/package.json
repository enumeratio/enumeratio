{
  "name": "@enumeratio/geometric",
  "version": "0.0.0",
  "private": true,
  "description": "The geometric-algebra layer over @enumeratio/hypercomplex: grade projection, the outer and regressive products, the contractions, the involutions and the Poincare dual.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/hypercomplex": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.151.0",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.151.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "algebras",
    "extends": [
      "hypercomplex"
    ],
    "group": "algebras",
    "declare": "declareGeometric",
    "declares": "./declares.json"
  }
}
