{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enumeratio.dev/schema/component-stories.schema.json",
  "title": "ComponentStories",
  "description": "One component's <Name>.stories.yaml: its stories, in page order.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ComponentStory"
  },
  "$defs": {
    "StoryVdom": {
      "description": "One node of a component story's vdom tree: a tag, its attributes, and its children or text.",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryVdom"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["tag"],
      "additionalProperties": false
    },
    "ComponentStory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "caption": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "vdom": {
          "$ref": "#/$defs/StoryVdom"
        }
      },
      "required": ["id", "caption", "vdom"],
      "additionalProperties": false
    }
  }
}
