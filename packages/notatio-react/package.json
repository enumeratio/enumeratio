{
  "name": "@enumeratio/notatio-react",
  "version": "0.0.0",
  "private": true,
  "description": "notatio-react: the symbols as React components — <Slider>, <Plot>, <Row> — generated from the element sources, and <Notatio expr> rendering an expression as a vdom.",
  "license": "WTFPL",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./generate": "./dist/generate.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "vp run @enumeratio/notatio#build && node --experimental-strip-types src/generate.ts",
    "build": "node --experimental-strip-types src/generate.ts && vp pack src/index.ts src/generate.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/notatio": "workspace:*",
    "@enumeratio/notatio-lit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
