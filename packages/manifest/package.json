{
  "name": "@enumeratio/manifest",
  "version": "0.0.0",
  "private": true,
  "description": "Every symbol head we know -- its packages, overloads and their types, parameter names, attributes and summary -- assembled at build time from the reference records and a bare compute-engine.",
  "license": "WTFPL",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./libraries": {
      "types": "./dist/libraries.d.mts",
      "import": "./dist/libraries.mjs"
    },
    "./package/*": {
      "types": "./dist/package/*.d.mts",
      "import": "./dist/package/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts && vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "semver": "catalog:"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.146.0",
    "@enumeratio/entry": "workspace:*",
    "@types/node": "^24",
    "@types/semver": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.146.0"
  }
}
