    "@notatio/combinatorics": "0.0.0",
    "@notatio/engine": "0.0.0",
    "@notatio/evaluation": "0.0.0",
    "@notatio/formats": "0.0.0",
    "@notatio/frontend": "0.0.0",
    "@notatio/manifest": "0.0.0",
    "@notatio/number-theory": "0.0.0",
    "@notatio/numerals": "0.0.0",
