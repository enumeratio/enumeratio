{
  "name": "@enumeratio/notatio-vue",
  "version": "0.0.0",
  "private": true,
  "description": "notatio-vue: the symbols as Vue components — <Slider>, <Plot>, <Row> — generated from the element sources, and <Notatio expr> rendering an expression as a vdom.",
  "license": "WTFPL",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./generate": "./dist/generate.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "vp run @enumeratio/notatio#build && node --experimental-strip-types src/generate.ts",
    "build": "node --experimental-strip-types src/generate.ts && vp pack src/index.ts src/generate.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/notatio": "workspace:*",
    "@enumeratio/notatio-lit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
