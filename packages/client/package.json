{
  "name": "@enumeratio/client",
  "version": "0.1.0",
  "description": "TypeScript read-through client for the pure-SQL enumeratio core (pg-enumeratio) running in PGlite — the math API everything else consumes.",
  "type": "module",
  "license": "Unlicense",
  "homepage": "https://enumeratio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enumeratio/enumeratio.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "browser": {
        "types": "./src/index.browser.ts",
        "default": "./src/index.browser.ts"
      },
      "default": {
        "types": "./src/index.browser.ts",
        "default": "./src/index.browser.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "pnpm --filter @enumeratio/data run build && tsgo --noEmit",
    "selfcert:rows": "node --import tsx selfcert-rows.mts",
    "selfcert:resolve": "node --import tsx selfcert-resolve.mts",
    "test": "vitest run",
    "selfcert:engine": "node --import tsx selfcert-engine.mts",
    "bench:engine": "node --import tsx bench-engine.mts"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.125.0",
    "@electric-sql/pglite": "^0.5.3",
    "@enumeratio/data": "workspace:^",
    "@enumeratio/math": "workspace:^",
    "debug": "^4.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
