{
  "name": "@enumeratio/oracle",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-check the reference catalogue against external systems: signature-level mappings, emitters, batch runners, and the blessed values a scan produces.",
  "license": "WTFPL",
  "files": [
    "dist",
    "kernels.json",
    "julia",
    "lean",
    "oscar",
    "python",
    "rust"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./kernels.json": "./kernels.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../reference/scripts/collect-mappings.ts && node ../reference/scripts/collect-defined-names.ts && node ../reference/scripts/collect-carrier-names.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/utils": "workspace:*",
    "@enumeratio/wolfram": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.149.0",
    "@enumeratio/adeles": "workspace:*",
    "@enumeratio/analytic": "workspace:*",
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/braid": "workspace:*",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/combinatorics": "workspace:*",
    "@enumeratio/config": "workspace:*",
    "@enumeratio/diagram": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/evaluation": "workspace:*",
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/geometric": "workspace:*",
    "@enumeratio/groupalgebra": "workspace:*",
    "@enumeratio/hecke": "workspace:*",
    "@enumeratio/hopf": "workspace:*",
    "@enumeratio/hypercomplex": "workspace:*",
    "@enumeratio/incidence": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/modular": "workspace:*",
    "@enumeratio/number-theory": "workspace:*",
    "@enumeratio/numerals": "workspace:*",
    "@enumeratio/plausible": "workspace:*",
    "@enumeratio/quiver": "workspace:*",
    "@enumeratio/residues": "workspace:*",
    "@enumeratio/structures": "workspace:*",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "enumeratio": {
    "layer": "tooling",
    "extends": []
  },
  "generated": [
    "src/mappings-data.ts",
    "src/defined-names-data.ts",
    "src/carrier-names-data.ts"
  ]
}
