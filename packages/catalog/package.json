{
  "name": "@enumeratio/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "The enumeratio catalog as resolvable resources: lazy context namespaces, a search path, and the promotion ladder from namespaced to blessed to global.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./src": "./src/index.ts",
    "./records": "./src/catalog-records-data.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../reference/scripts/collect-catalog-records.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/engine": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.146.0",
    "@enumeratio/combinatorics": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/plausible": "workspace:*",
    "@enumeratio/statistics": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.146.0"
  },
  "generated": [
    "src/catalog-records-data.ts"
  ]
}
