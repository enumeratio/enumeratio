{
  "name": "@enumeratio/engine",
  "version": "0.1.0",
  "description": "enumeratio as a loadable compute-engine library: combinatorial collections with O(1) rank/unrank random access, backing CE's own CollectionHandlers. Wave 1 = the permutations vertical (SymmetricGroup + Inversions). Name provisional.",
  "type": "module",
  "license": "Unlicense",
  "homepage": "https://enumeratio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enumeratio/enumeratio.git",
    "directory": "packages/engine"
  },
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "0.125.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@cortex-js/compute-engine": "0.125.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
