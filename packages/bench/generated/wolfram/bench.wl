(* Generated by packages/bench/scripts/generate.ts from the catalogue; do not edit.
   wolframscript -file bench.wl <port>: connects to the coordinator on 127.0.0.1:<port>. *)

protocol = <|"warmup" -> 3, "warmupMs" -> 1000, "samples" -> 15, "minSamples" -> 5, "batchBelowMs" -> 1, "minSampleMs" -> 10|>;

cases = <|
  "Zeta/zeta-3p5-to-30-digits" -> <|"budget" -> 10, "calls" -> {Hold[N[Zeta[3.5`30], 30]]}|>,
  "PolyLog/polylog-3-one-half-to-30-digits" -> <|"budget" -> 10, "calls" -> {Hold[N[PolyLog[3, Rational[1, 2]], 30]]}|>,
  "HurwitzZeta/hurwitz-zeta-machine" -> <|"budget" -> 10, "calls" -> {Hold[N[HurwitzZeta[2.5`, 0.3`]]]}|>,
  "Gamma/gamma-random-reals-machine" -> <|"budget" -> 10, "calls" -> {Hold[N[Gamma[24.026529921218753`]]], Hold[N[Gamma[17.407367952284403`]]], Hold[N[Gamma[38.77917202899698`]]], Hold[N[Gamma[46.78631058672909`]]], Hold[N[Gamma[44.87958628672641`]]], Hold[N[Gamma[6.665662877028808`]]], Hold[N[Gamma[49.318621157319285`]]], Hold[N[Gamma[23.027127810637467`]]], Hold[N[Gamma[48.55525078927167`]]], Hold[N[Gamma[35.59063852287363`]]], Hold[N[Gamma[29.168683981057256`]]], Hold[N[Gamma[3.201277957763523`]]], Hold[N[Gamma[24.212262262008153`]]], Hold[N[Gamma[33.7944600781193`]]], Hold[N[Gamma[12.926321253180504`]]], Hold[N[Gamma[35.72455013496801`]]]}|>,
  "Factorial/factorial-10-to-the-4" -> <|"budget" -> 10, "calls" -> {Hold[Mod[Factorial[10000], 1000000007]]}|>,
  "Factorial/factorial-10-to-the-5" -> <|"budget" -> 10, "calls" -> {Hold[Mod[Factorial[100000], 1000000007]]}|>,
  "Binomial/binomial-10-to-the-5-choose-3-10-to-the-4" -> <|"budget" -> 10, "calls" -> {Hold[Mod[Binomial[100000, 30000], 1000000007]]}|>,
  "Fibonacci/fibonacci-10-to-the-5" -> <|"budget" -> 10, "calls" -> {Hold[Mod[Fibonacci[100000], 1000000007]]}|>
|>;

(* ns per call over k calls, caches cleared first; calls cycle through the sampled inputs *)
next = 0;
call[calls_] := ReleaseHold[calls[[Mod[next++, Length[calls]] + 1]]];
timeK[calls_, k_] := (ClearSystemCache[]; 10.^9 First[AbsoluteTiming[Do[call[calls], {k}]]]/k);

(* measure() in packages/bench/src/protocol.ts *)
measure[calls_, budgetMs_] := Module[{start = SessionTime[], spent, k = 1, single, samples = {}, w = 0},
  spent := 1000 (SessionTime[] - start);
  single = Max[timeK[calls, 1], 1];
  If[single < 10^6 protocol["batchBelowMs"],
    While[single k < 10^6 protocol["minSampleMs"] && spent < budgetMs, k *= 2]];
  While[w < protocol["warmup"] && spent < protocol["warmupMs"] && spent < budgetMs,
    single = timeK[calls, k]; w++];
  While[Length[samples] < protocol["samples"],
    If[Length[samples] >= protocol["minSamples"] && spent >= budgetMs, Break[]];
    AppendTo[samples, timeK[calls, k]];
    If[spent >= 4 budgetMs, Break[]]];
  <|"k" -> k, "samplesNs" -> samples, "timedOut" -> Length[samples] < protocol["minSamples"]|>];

sock = SocketConnect[{"127.0.0.1", ToExpression[Last[$ScriptCommandLine]]}];
reply[name_, assoc_] := WriteString[sock, "<<", name, ">>", ExportString[assoc, "RawJSON", "Compact" -> True], "\n"];

run[name_] := If[!KeyExistsQ[cases, name],
  reply[name, <|"error" -> "no case " <> name|>],
  Module[{c = cases[name], value},
    value = Quiet[Check[ReleaseHold[First[c["calls"]]], $Failed]];
    If[value === $Failed,
      reply[name, <|"error" -> "evaluation failed"|>],
      next = 0;
      reply[name, Join[<|"value" -> ToString[value, InputForm], "version" -> $Version|>, measure[c["calls"], 1000 c["budget"]]]]]]];

While[StringQ[line = ReadLine[sock]] && line =!= "quit", run[line]];
Close[sock];
