{
  "name": "@enumeratio/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-system benchmarks: a catalogue of cases as data, native scripts generated per system through the oracle's emit, one measurement protocol, and per-run JSON reports. See https://github.com/enumeratio/enumeratio/wiki/Benchmarking.",
  "license": "WTFPL",
  "files": [
    "dist",
    "catalogue",
    "generated"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "build": "node scripts/generate.ts && vp pack",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/oracle": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "@types/node": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
    "layer": "tooling",
    "extends": []
  }
}
