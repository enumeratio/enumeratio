{
  "name": "@enumeratio/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "The base of the interface: the symbol-to-component map and its lowering, the AST as a vdom, the control contract, the arithmetic of scrubbing and playback, the pure SVG renderers. No UI framework.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./conventional-latex": "./dist/conventional-latex.mjs",
    "./core": "./dist/core.mjs",
    "./declare-carriers": "./dist/declare-carriers.mjs",
    "./display": "./dist/display.mjs",
    "./kernel-host": "./dist/kernel-host.mjs",
    "./plot-compile": "./dist/plot-compile.mjs",
    "./prerender": "./dist/prerender.mjs",
    "./reflect": "./dist/reflect.mjs",
    "./symbols": "./dist/symbols.mjs",
    "./vdom": "./dist/vdom.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/core.ts src/symbols.ts src/vdom.ts src/reflect.ts src/conventional-latex.ts src/declare-carriers.ts src/display.ts src/kernel-host.ts src/plot-compile.ts src/prerender.ts && node scripts/build-forms.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/analytic": "workspace:*",
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/ce-patches": "workspace:*",
    "@enumeratio/engine": "workspace:*",
    "@enumeratio/evaluation": "workspace:*",
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/manifest": "workspace:*",
    "@enumeratio/polytope": "workspace:*",
    "@enumeratio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "@enumeratio/braid": "workspace:*",
    "@enumeratio/combinatorics": "workspace:*",
    "@enumeratio/entry": "workspace:*",
    "@enumeratio/oracle": "workspace:*",
    "@enumeratio/reference": "workspace:*",
    "@enumeratio/wolfram": "workspace:*",
    "@types/node": "catalog:",
    "@webgpu/types": "^0.1.60",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
    "late": "./declare-carriers#declareFrontendCarriers"
  },
  "generated": [
    "generated/forms.json"
  ]
}
