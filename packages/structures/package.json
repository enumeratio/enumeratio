{
  "name": "@enumeratio/structures",
  "version": "0.0.0",
  "private": true,
  "description": "Mathematical structure as compute-engine protocols: orders, lattices, ticks, products. A generic head requires structure; a type conforms to it (https://github.com/enumeratio/enumeratio/wiki/Structures).",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "workspace:*",
    "@enumeratio/engine": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
    "notation": "./notation",
    "declare": [
      "ensureProtocols",
      "ensureAlgebraHeads",
      "ensureOperationHeads"
    ],
    "late": "declareStructures"
  }
}
