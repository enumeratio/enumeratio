{
  "name": "@enumeratio/boxes",
  "version": "0.0.0",
  "private": true,
  "description": "Wolfram-style box primitives: the presentation tree between an expression and its rendering, with MathML, LaTeX and text serialisers.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./render": {
      "types": "./dist/render.d.mts",
      "import": "./dist/render.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/manifest": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.148.0",
    "@enumeratio/config": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.148.0"
  },
  "enumeratio": {
    "layer": "base",
    "extends": [],
    "entries": {
      "./render": {
        "layer": "presentation",
        "extends": [
          "boxes"
        ]
      }
    },
    "declare": "declareBoxes",
    "declares": "./declares.json"
  }
}
