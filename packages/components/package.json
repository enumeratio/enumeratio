{
  "name": "@enumeratio/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every enumeratio Lit web component: pure data→visual figures (*-glyph / *-figure, incl. the three.js polytope views) plus client-backed enumeratio-* elements (expression, notation, …) that talk to @enumeratio/client.",
  "exports": {
    ".": "./src/index.ts",
    "./figures": "./src/figures/index.ts",
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@enumeratio/client": "workspace:*",
    "@enumeratio/expressions": "workspace:*",
    "@vscode/markdown-it-katex": "^1.1.1",
    "katex": "^0.16.11",
    "lit": "^3.2.1",
    "markdown-it": "^14.1.0",
    "mathlive": "^0.110.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/three": "^0.184.1",
    "typescript": "^5.7.2"
  }
}
