{
  "name": "@enumeratio/notatio",
  "version": "0.1.0",
  "description": "Notatio — the notebook's expression language. LaTeX → MathJSON → typed, catalog-bound AST → @enumeratio/client IR: compute-engine's LaTeX parser and MathJSON, our own binder/typer over the catalog (collections as domains, elements as a type), lowering to the engine seam. Derived from compute-engine but its own language.",
  "type": "module",
  "license": "WTFPL",
  "homepage": "https://enumeratio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enumeratio/enumeratio.git",
    "directory": "packages/notatio"
  },
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "selfcert": "node --import tsx selfcert-notatio.mts"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.125.0",
    "@enumeratio/client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
