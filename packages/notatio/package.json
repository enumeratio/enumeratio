{
  "name": "@enumeratio/notatio",
  "version": "0.0.0",
  "private": true,
  "description": "notatio: the base of the notation layer — the symbol-to-component map and its lowering, the arithmetic of scrubbing and playback, the control contract, and the pure SVG renderers. No UI framework.",
  "license": "WTFPL",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./reflect": "./dist/reflect.mjs",
    "./symbols": "./dist/symbols.mjs",
    "./vdom": "./dist/vdom.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/symbols.ts src/vdom.ts src/reflect.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/analytic": "workspace:*",
    "@enumeratio/formats": "workspace:*",
    "@enumeratio/polytope": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.128.0",
    "@enumeratio/braid": "workspace:*",
    "@types/node": "catalog:",
    "@webgpu/types": "^0.1.60",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.128.0"
  }
}
