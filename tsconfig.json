{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "//": "@enumeratio/data is the workspace package with no tsconfig of its own; the rest (client, cli, explorer) carry theirs.",
  "include": ["packages/data"]
}
